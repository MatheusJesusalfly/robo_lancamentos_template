# Fale com @BotFather no Telegram, /newbot, e cole o token aqui.
TELEGRAM_TOKEN=

# Fale com @userinfobot no Telegram para descobrir o seu id numerico.
# Sem ninguem aqui, o robo nao obedece a ninguem -- e isso e de proposito.
AUTORIZADOS=

# aistudio.google.com -> Get API key. Nao precisa de cartao.
# ATENCAO: no plano gratuito o Google pode usar o que passa por aqui para
# treinar, e revisores humanos podem ler. Nao aponte para venda real de cliente
# sem trocar para o plano pago.
GEMINI_API_KEY=
# Se der erro 404, o nome do modelo mudou: veja a lista em aistudio.google.com.
# O "-lite" e o padrao porque aguenta melhor a fila do plano gratuito.
GEMINI_MODELO=gemini-3.5-flash-lite

# A URL que o Apps Script deu ao implantar, e o segredo que voce escolheu.
PLANILHA_URL=
PLANILHA_SEGREDO=
